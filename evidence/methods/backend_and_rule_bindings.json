    {
      "path": "configs/experiments/tmlr_v6_p0_phase2_semantic_addendum.json",
      "bytes": 43072,
      "sha256": "c5356e4141ef21dda8956109a855a9b7f89ae51095b4233ee709ed4110c24131",
      "selection_type": "JSON_POINTER",
      "entries": [
        {
          "selector": "/statistics_and_mechanical_rules",
          "value": {
            "unit": "image_group_id",
            "paired": true,
            "bootstrap_replicates": 2000,
            "bootstrap_seed": 13,
            "percentile_interval": [
              0.025,
              0.975
            ],
            "same_bootstrap_group_count_matrix_for_all_fixed_contrasts": true,
            "bootstrap_sampling": "sort unique image_group_id; let G be their count; numpy.random.Generator(numpy.random.PCG64(13)).integers(0,G,size=(2000,G)); each row resamples groups with replacement and retains every state belonging to each sampled group, including multiplicity; reuse this exact index matrix for every fixed contrast",
            "bootstrap_metric_recomputation": "recompute each complete metric for A and B on every paired group resample, then d_b=m_A_b-m_B_b; do not average fold metrics or state-level effects",
            "point_effect": "d=m_A-m_B from the complete paired analysis population before resampling",
            "percentile_quantile_method": "numpy linear",
            "group_win_fraction": "among paired groups where both group-level metrics are defined, fraction with m_A_group<m_B_group; equality is neither a win nor a loss; if no paired group is defined the fraction is null",
            "group_loss_fraction": "among paired groups where both group-level metrics are defined, fraction with m_A_group>m_B_group; equality is neither a win nor a loss; if no paired group is defined the fraction is null",
            "folds_as_independent_replicates": false,
            "class_states_as_independent_replicates": false,
            "primary_metrics": [
              "absolute_residual_mae",
              "drre"
            ],
            "parent_primary_contrasts": [
              "R1_P-R0_SMALL_P",
              "R1_P-R0_CM_P",
              "R1_P-RECT_P",
              "R1_P-UNION_P"
            ],
            "additional_interpretation_contrasts_frozen_before_metric_inspection": [
              "R0_CM_P-R0_SMALL_P",
              "RECT_P-R0_CM_P",
              "UNION_P-R0_CM_P"
            ],
            "practical_margin_fraction": 0.05,
            "practical_margin_source": "pre-existing five-percent historical fit gates and reviewer-revision practical thresholds; not V6 results",
            "CLEAR_BETTER": "for lower-is-better nonnegative metric m: paired effect d=m_A-m_B has 95% CI upper<0, full-sample m_A<=0.95*m_B, and group win fraction>0.5; impossible when m_B=0",
            "CLEAR_WORSE": "for lower-is-better nonnegative metric m: paired effect d=m_A-m_B has 95% CI lower>0, full-sample m_A>=1.05*m_B, and group loss fraction>0.5; when m_B=0 any strictly positive m_A satisfies the five-percent magnitude clause but still must satisfy the CI and group-loss clauses",
            "PRACTICAL_TIE": "the complete paired effect CI lies within [-0.05*m_B,+0.05*m_B]; if m_B==0 only exact zero qualifies",
            "UNCERTAIN": "every comparison not satisfying CLEAR_BETTER, CLEAR_WORSE, or PRACTICAL_TIE",
            "bootstrap_wording": "bootstrap-supported; not a multiplicity-adjusted confirmatory p-value",
            "utility_thresholds": {
              "meaningful_normalized_regret": "defined and strictly <0.95",
              "meaningful_gain_capture": "defined and strictly >0.05 with realized_gain>0",
              "threshold_status": "frozen interpretive thresholds, not formal hypothesis tests"
            },
            "derived_predicates": {
              "FIDELITY_STRONG": "CLEAR_BETTER(R1_P,R0_SMALL_P,absolute_residual_mae) and CLEAR_BETTER(R1_P,R0_SMALL_P,drre)",
              "FIDELITY_PARTIAL": "exactly one primary metric is CLEAR_BETTER for R1_P versus R0_SMALL_P and the other is not CLEAR_WORSE",
              "R1_BEYOND_CAPACITY": "CLEAR_BETTER(R1_P,R0_CM_P,absolute_residual_mae) and CLEAR_BETTER(R1_P,R0_CM_P,drre)",
              "GENERIC_LOCALIZATION_CLEAR": "R1_P,RECT_P,UNION_P are each CLEAR_BETTER than R0_CM_P on both primary metrics, and R1_P is PRACTICAL_TIE with RECT_P and UNION_P on both primary metrics",
              "CAPACITY_DOMINANT": "R0_CM_P is CLEAR_BETTER than R0_SMALL_P on both primary metrics and R1_P is PRACTICAL_TIE with R0_CM_P on both primary metrics",
              "PARTIAL_LOCALIZATION": "at least one of R1_P,RECT_P,UNION_P is CLEAR_BETTER than R0_CM_P on both primary metrics, or R1_P is CLEAR_BETTER on one metric and not CLEAR_WORSE on the other",
              "CLEAR_UTILITY_TRANSLATION": "normalized regret at lambda=0 is meaningful and all six cells from budgets 0.01,0.02,0.05 crossed with FORCED_K,POSITIVE_GAIN_CAP have positive oracle headroom and meaningful gain capture",
              "PREDICTION_INTERVENTION_GAP_PERSISTS": "FIDELITY_STRONG or FIDELITY_PARTIAL, all required lambda=0 oracle denominators are positive, normalized regret is not meaningful, and none of the six primary sparse cells has meaningful gain capture",
              "PREDICTION_INTERVENTION_GAP_WEAKENS": "FIDELITY_STRONG or FIDELITY_PARTIAL and positive oracle headroom exists, but the utility cells are mixed between meaningful and not meaningful",
              "PREDICTION_INTERVENTION_GAP_NOT_SUPPORTED": "no prospective fidelity signal, utility is unassessable, or R1_P has CLEAR_UTILITY_TRANSLATION",
              "EQUALLY_MEANINGFUL_NEW_RESULT": "R1_P has CLEAR_UTILITY_TRANSLATION, or at least two of R2_P,R3_P,Q2_P,L2D_P,SPO_PLUS_P at lambda=0 have CLEAR_UTILITY_TRANSLATION; LL4TTA_P is excluded as an alias",
              "POST_HOC_REVERSAL": "the primary pixel-mismatch gap persists but any segmentation-native sensitivity utility has CLEAR_UTILITY_TRANSLATION on its registered population, or ALL_STATES has a persistent gap while REFERENCE_POSITIVE_AND_A0_SOURCE_PRESENT has CLEAR_UTILITY_TRANSLATION"
            }
          }
        },
        {
          "selector": "/final_classification",
          "value": {
            "classification_only_after": {
              "first_batch_valid_runs": 75,
              "phase2_valid_training_jobs": 345,
              "metric_and_sensitivity_pipeline_pass": true,
              "all_registered_output_rows_present": true,
              "all_named_integrity_tests_pass": true,
              "compileall_pass": true,
              "pip_check_pass": true,
              "git_diff_check_pass": true,
              "git_fsck_full_pass": true,
              "protected_access_zero": true
            },
            "precedence": [
              "INTEGRITY_FAILURE",
              "STRONG",
              "MIXED",
              "NOT_SUPPORTED"
            ],
            "INTEGRITY_FAILURE": {
              "condition": "any classification_only_after requirement fails",
              "terminal_label_if_one_of_the_three_labels_is_required": "TMLR_V6_PROSPECTIVE_CORE_NOT_SUPPORTED",
              "interpretation": "invalid or incomplete evidence, not evidence of a negative scientific effect"
            },
            "STRONG": {
              "label": "TMLR_V6_PROSPECTIVE_CORE_STRONG",
              "all_required": [
                "all classification_only_after requirements pass",
                "FIDELITY_STRONG",
                "R1_BEYOND_CAPACITY or GENERIC_LOCALIZATION_CLEAR",
                "PREDICTION_INTERVENTION_GAP_PERSISTS or EQUALLY_MEANINGFUL_NEW_RESULT",
                "not POST_HOC_REVERSAL"
              ]
            },
            "MIXED": {
              "label": "TMLR_V6_PROSPECTIVE_CORE_MIXED",
              "all_required": [
                "all classification_only_after requirements pass",
                "STRONG is false",
                "at least one stable registered pattern holds"
              ],
              "stable_registered_patterns": [
                "FIDELITY_STRONG",
                "FIDELITY_PARTIAL",
                "CAPACITY_DOMINANT",
                "GENERIC_LOCALIZATION_CLEAR",
                "PARTIAL_LOCALIZATION",
                "PREDICTION_INTERVENTION_GAP_WEAKENS",
                "CLEAR_UTILITY_TRANSLATION for any registered non-alias model",
                "POST_HOC_REVERSAL"
              ]
            },
            "NOT_SUPPORTED": {
              "label": "TMLR_V6_PROSPECTIVE_CORE_NOT_SUPPORTED",
              "condition": "INTEGRITY_FAILURE, or all classification requirements pass but neither STRONG nor MIXED holds"
            },
            "post_hoc_sensitivity_may_downgrade_strong_to_mixed": true,
            "post_hoc_sensitivity_may_upgrade_to_strong": false,
            "protected_confirmation_automatically_authorized": false,
            "exactly_one_terminal_label": true
          }
        }
      ]
    },
