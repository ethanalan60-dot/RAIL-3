{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rail3.m06e.model-run-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_id", "scale", "phase", "outer_fold", "seed", "status", "device", "train_group_ids", "inner_stop_group_ids", "heldout_group_ids", "data_manifest_sha256", "feature_manifest_sha256", "target_manifest_sha256", "fold_manifest_sha256", "protocol_sha256", "git_commit", "started_at_utc", "ended_at_utc", "best_epoch", "epochs_completed", "parameter_count", "peak_vram_bytes", "gpu_wall_seconds", "single_residual_predictor", "independent_heads", "checkpoint", "prediction", "validation_row_access", "heldout_access"],
  "properties": {
    "schema_version": {"const": "rail3.m06e.model-run-manifest.v1"},
    "run_id": {"type": "string", "pattern": "^m06e_run_[0-9a-f]{64}$"},
    "model_id": {"enum": ["R0_GLOBAL_RESIDUAL", "R1_ATOMIC_RESIDUAL", "R2_ATOMIC_PIDR", "Q2_DIRECT_GAIN", "P1_LINEAR_PAL", "R3_RETROSPECTIVE_ATOMIC"]},
    "scale": {"enum": ["S250", "S500", "S1000", "S_MAX", "S1364"]},
    "phase": {"enum": ["outer_crossfit", "final_fit", "offline_diagnostic"]},
    "outer_fold": {"type": ["string", "null"]},
    "seed": {"enum": [13, 37, 71, 101, 131]},
    "status": {"enum": ["PASS", "FAIL_CLOSED", "RESOURCE_DEFERRED"]},
    "device": {"type": "string"},
    "train_group_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inner_stop_group_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "heldout_group_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "data_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fold_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "started_at_utc": {"type": "string"}, "ended_at_utc": {"type": "string"},
    "best_epoch": {"type": ["integer", "null"], "minimum": 1},
    "epochs_completed": {"type": "integer", "minimum": 0},
    "parameter_count": {"type": "integer", "minimum": 1},
    "peak_vram_bytes": {"type": "integer", "minimum": 0},
    "gpu_wall_seconds": {"type": "number", "minimum": 0},
    "wall_seconds": {"type": "number", "minimum": 0},
    "visible_device": {"type": ["string", "null"]},
    "inner_stop_loss": {"type": "number"},
    "cost_median_seconds": {"type": "number", "exclusiveMinimum": 0},
    "counts": {"type": "object"},
    "single_residual_predictor": {"type": "boolean"},
    "independent_heads": {"type": "array", "maxItems": 0},
    "independent_q_head_in_R_models": {"const": false},
    "opportunity_head_in_R_models": {"const": false},
    "checkpoint": {"$ref": "#/$defs/fileIdentity"},
    "prediction": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "validation_row_access": {"const": false},
    "heldout_access": {"type": "object", "additionalProperties": false, "required": ["calibration30", "pilot_test30", "official_voc_val", "validation40"], "properties": {"calibration30": {"const": 0}, "pilot_test30": {"const": 0}, "official_voc_val": {"const": 0}, "validation40": {"const": 0}}}
  },
  "$defs": {
    "fileIdentity": {"type": "object", "additionalProperties": false, "required": ["logical_path", "bytes", "sha256"], "properties": {"logical_path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
